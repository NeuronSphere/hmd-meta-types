GO_DIR    := src/go/metatypes
GO        := go
GOFLAGS   :=
# The docker-* targets run any target below in a Go container, for a host
# without a Go toolchain. Module and build caches live in named volumes so
# repeat runs are fast.
GO_IMAGE    ?= golang:1.25
DOCKER_RUN   = docker run --rm \
                 -v $(CURDIR):/src -w /src \
                 -v hmd-gomod:/go/pkg/mod -v hmd-gocache:/root/.cache/go-build \
                 $(GO_IMAGE)

# The golden corpus (testdata/corpus) is generated by the Python implementation
# and checked by the Go tests. See docs/requirements/corpus.rst.
PY_IMAGE        ?= python:3.11-slim
PY_DEPS         := jsonschema==4.23.0 python-dateutil==2.8.2
PROJECTBUILDER  ?= ghcr.io/hmdlabs/hmd-img-projectbuilder:0.5.395
HMD_TMPL_VOCABGEN ?= $(abspath $(CURDIR)/../hmd-tmpl-vocabgen)
PY_RUN           = docker run --rm -v $(CURDIR):/repo -w /repo -v hmd-pipcache:/root/.cache/pip \
                     -e PYTHONPATH=/repo/src/python $(PY_IMAGE) sh -c \
                     'pip install -q --root-user-action=ignore $(PY_DEPS) >/dev/null 2>&1 &&
# The private index for hmd-cli-mickey, from the macOS keychain unless already set.
# It reaches the container as an environment variable, never in a command line.
PRIVATE_INDEX    = $${PIP_EXTRA_INDEX_URL:-https://hmd_ro:$$(security find-generic-password -s uv:hmdlabs.jfrog.io -a hmd_ro -w | python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.stdin.read().strip(),safe=""))')@hmdlabs.jfrog.io/artifactory/api/pypi/hmd_pypi/simple}

.PHONY: all test test-verbose test-race cover vet fmt fmt-check reqs reqs-check check tidy clean \
        docker-corpus-golden docker-corpus-render docker-corpus-roundtrip help

all: check

## test: run the Go unit and corpus tests
test:
	cd $(GO_DIR) && $(GO) test $(GOFLAGS) ./...

## test-verbose: run the Go tests with verbose output
test-verbose:
	cd $(GO_DIR) && $(GO) test $(GOFLAGS) -v ./...

## test-race: run the Go tests under the race detector
test-race:
	cd $(GO_DIR) && $(GO) test $(GOFLAGS) -race -count=1 ./...

## cover: report unit-test coverage per package
cover:
	cd $(GO_DIR) && $(GO) test $(GOFLAGS) -cover ./...

## vet: run go vet
vet:
	cd $(GO_DIR) && $(GO) vet ./...

## fmt: format the Go sources
fmt:
	cd $(GO_DIR) && gofmt -w .

## fmt-check: fail if any Go source is unformatted
fmt-check:
	@files=$$(cd $(GO_DIR) && gofmt -l .); \
	if [ -n "$$files" ]; then echo "unformatted (run make fmt):"; echo "$$files"; exit 1; fi

# reqtrace is hmd-cli-bartleby's Apache-2.0 traceability tool; the
# requirement and annotation conventions here are the same as there.
REQTRACE := github.com/neuronsphere/hmd-cli-bartleby/src/go/reqtrace/cmd/reqtrace@v0.3.1

## reqs: regenerate docs/requirements/traceability.rst
reqs:
	cd $(GO_DIR) && $(GO) run $(REQTRACE) -repo $(CURDIR)

## reqs-check: fail if a requirement is untested, a test is untagged, or the matrix is stale
reqs-check:
	cd $(GO_DIR) && $(GO) run $(REQTRACE) -repo $(CURDIR) -check

## check: fmt-check + vet + race tests + traceability — what CI should run
check: fmt-check vet test-race reqs-check

## tidy: tidy and verify the Go module
tidy:
	cd $(GO_DIR) && $(GO) mod tidy && $(GO) mod verify

## clean: remove build artifacts
clean:
	rm -rf build

## docker-corpus-golden: regenerate testdata/corpus cases and Python goldens (Python container)
docker-corpus-golden:
	$(PY_RUN) python tools/corpus/cases.py && python tools/corpus/golden.py'

## docker-corpus-render: re-render internal/corpus through hmd-tmpl-vocabgen's go_lib (projectbuilder)
docker-corpus-render:
	PIP_EXTRA_INDEX_URL="$(PRIVATE_INDEX)" docker run --rm --entrypoint sh -e PIP_EXTRA_INDEX_URL \
	  -v $(CURDIR):/repo -v $(HMD_TMPL_VOCABGEN):/vocabgen:ro $(PROJECTBUILDER) /repo/tools/corpus/render_go_lib.sh

## docker-corpus-roundtrip: Go writes every corpus output, Python reads each back to its golden
docker-corpus-roundtrip:
	rm -rf build/corpus-go
	docker run --rm -v $(CURDIR):/src -w /src/$(GO_DIR) -e CORPUS_GO_OUT=/src/build/corpus-go \
	  -v hmd-gomod:/go/pkg/mod -v hmd-gocache:/root/.cache/go-build $(GO_IMAGE) go test -count=1 -run Corpus ./...
	$(PY_RUN) python tools/corpus/golden.py --check build/corpus-go'

## docker-<target>: run any other target inside a Go container (e.g. docker-check)
docker-%:
	$(DOCKER_RUN) make $*

## help: show this help
help:
	@grep -E '^## ' $(MAKEFILE_LIST) | sed 's/^## /  /'
