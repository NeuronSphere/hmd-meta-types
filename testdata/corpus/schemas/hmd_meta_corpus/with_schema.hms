{
  "name": "with_schema",
  "namespace": "hmd_meta_corpus",
  "metatype": "noun",
  "description": "Collections and mappings validated by JSON Schema, as hmd-lang-deployment does.",
  "attributes": {
    "items": {
      "type": "collection",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {"name": {"type": "string"}, "n": {"type": "integer"}},
          "required": ["name"]
        }
      }
    },
    "config": {
      "type": "mapping",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "mode": {"enum": ["a", "b"]},
          "limits": {"type": "object", "properties": {"max": {"type": "number", "minimum": 0}}}
        },
        "required": ["mode"],
        "additionalProperties": false
      }
    }
  }
}
